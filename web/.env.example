# Optional overrides for PanicRevoke addresses (public values only — never put keys here).
# After a live deploy, web/src/deployments.json is updated automatically. Leave these
# empty to use that file. Empty in both places = "not deployed yet" in the dapp
# (scanning still works; register/panic stay disabled).
VITE_PANIC_MAINNET=
VITE_PANIC_BASE=
VITE_PANIC_ANVIL=
VITE_USDC_ANVIL=
# Optional custom RPCs (public endpoints are used otherwise)
VITE_MAINNET_RPC=
VITE_BASE_RPC=
VITE_ANVIL_RPC=http://127.0.0.1:8622
